---
/**
 * Products as one flat panel split by hairlines (same treatment as
 * LogoGrid.astro). Status lines are plain muted text, not pills.
 * Entries live in src/data/products.ts.
 */
import { PRODUCTS } from '../data/products';
---

<ul class="products">
	{PRODUCTS.map(({ eyebrow, title, text, status, links }) => (
		<li class="products__item">
			<p class="products__eyebrow">{eyebrow}</p>
			<h3 class="products__title">{title}</h3>
			{text && <p class="products__text">{text}</p>}
			{status && <p class="products__status">{status}</p>}
			<div class="products__links">
				{links.map(({ label, href, external }) => (
					<a
						class="btn btn--ghost"
						href={href}
						{...(external && { target: '_blank', rel: 'noopener noreferrer' })}
					>
						{label} &#8594;
					</a>
				))}
			</div>
		</li>
	))}
</ul>

<style>
	.products {
		display: grid;
		gap: 1px;
		margin: 0;
		padding: 0;
		list-style: none;
		background: var(--line);
		border: 1px solid var(--line);
		border-radius: 12px;
		overflow: hidden;
	}
	@media (min-width: 48rem) {
		.products { grid-template-columns: repeat(2, 1fr); }
	}

	.products__item {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.75rem 1.5rem;
		background: var(--ground-lift);
	}
	.products__eyebrow {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.13em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.products__title {
		font-size: 1.375rem;
		line-height: 1.25;
		letter-spacing: -0.01em;
	}
	.products__text {
		margin: 0;
		color: var(--text-soft);
	}
	.products__status {
		margin: 0;
		font-size: 0.875rem;
		color: var(--muted);
	}
	/* Pushed to the bottom so both cells' buttons line up. */
	.products__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: auto;
		padding-top: 0.75rem;
	}
</style>
