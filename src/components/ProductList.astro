---
/**
 * Products floating on the page, two across from tablet up. Each shows its
 * type tags (plain outlined labels, not coloured pills), title, text and one
 * call to action. Entries live in src/data/products.ts.
 */
import { PRODUCTS } from '../data/products';
---

<ul class="products">
	{PRODUCTS.map(({ title, text, tags, cta }) => (
		<li class="products__item">
			<ul class="products__tags">
				{tags.map((tag) => <li class="products__tag">{tag}</li>)}
			</ul>
			<h3 class="products__title">{title}</h3>
			{text && <p class="products__text">{text}</p>}
			<div class="products__action">
				<a
					class="btn btn--ghost"
					href={cta.href}
					{...(cta.external && { target: '_blank', rel: 'noopener noreferrer' })}
				>
					{cta.label} &#8594;
				</a>
			</div>
		</li>
	))}
</ul>

<style>
	.products {
		display: grid;
		gap: 3rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	@media (min-width: 48rem) {
		.products {
			grid-template-columns: repeat(2, 1fr);
			gap: 3rem 4rem;
		}
	}

	.products__item {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.75rem;
	}
	.products__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.products__tag {
		padding: 0.15rem 0.55rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.products__title {
		font-size: 1.375rem;
		line-height: 1.25;
		letter-spacing: -0.01em;
	}
	.products__text {
		margin: 0;
		color: var(--text-soft);
	}
	/* Pushed to the bottom so both products' buttons line up. */
	.products__action {
		margin-top: auto;
		padding-top: 0.75rem;
	}
</style>
