---
/**
 * A rising staircase of numbered steps, one bar per step, each taller than
 * the last. Bars grow in turn once the graphic is well into view; reduced
 * motion shows them finished.
 *
 * Props:
 *   steps  labels, first to last
 */
interface Props {
	steps: string[];
}
const { steps } = Astro.props;
---

<figure class="steps" style={`--n: ${steps.length}`}>
	<ol class="steps__list">
		{steps.map((label, i) => (
			<li class="steps__step" style={`--i: ${i}`}>
				<span class="steps__bar">
					<span class="steps__num">{i + 1}</span>
				</span>
				<span class="steps__label">{label}</span>
			</li>
		))}
	</ol>
</figure>

<style>
	.steps {
		margin: 0;
	}
	.steps__list {
		display: grid;
		grid-template-columns: repeat(var(--n), 1fr);
		align-items: end;
		gap: 0.75rem;
		height: 15rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.steps__step {
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		gap: 0.6rem;
		height: 100%;
	}
	/* Each bar a third taller than the one before it. */
	.steps__bar {
		display: flex;
		align-items: flex-start;
		height: calc((var(--i) + 1) / var(--n) * 75%);
		padding: 0.6rem 0.75rem;
		border-radius: 6px 6px 0 0;
		background: color-mix(in srgb, var(--accent) calc(35% + var(--i) * 25%), var(--surface));
		transform-origin: bottom;
		transition: transform 0.7s var(--ease);
		transition-delay: calc(var(--i) * 0.25s);
	}
	.steps.is-pending .steps__bar { transform: scaleY(0); }
	.steps__num {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		font-weight: 600;
		/* Light: the first bars are a dark mix and would swallow dark text. */
		color: var(--text);
	}
	.steps__label {
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1.3;
		color: var(--text);
	}
</style>

<script>
	/* Grow once half visible; reduced motion keeps the finished staircase. */
	const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

	document.querySelectorAll<HTMLElement>('.steps').forEach((steps) => {
		if (!motionOk || !('IntersectionObserver' in window)) return;
		steps.classList.add('is-pending');
		const observer = new IntersectionObserver(([entry]) => {
			if (!entry.isIntersecting) return;
			observer.disconnect();
			steps.classList.remove('is-pending');
		}, { threshold: 0.5 });
		observer.observe(steps);
	});
</script>
