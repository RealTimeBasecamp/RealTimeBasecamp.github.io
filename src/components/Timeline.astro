---
/**
 * Career timeline: a vertical rail with one stop per role, newest first.
 * As the visitor scrolls down, an accent line fills the rail and lights each
 * stop it passes. It only ever grows, and once full the scroll listener is
 * removed, so it plays through once. Without JS or with reduced motion the
 * rail is simply full.
 *
 * Props:
 *   items  Role[] from src/data/experience.ts (EXPERIENCE)
 */
import type { Role } from '../data/experience';

interface Props {
	items: Role[];
}
const { items } = Astro.props;
---

<ol class="timeline">
	{items.map(({ company, role, dates, logo: Logo }) => (
		<li class="timeline__stop">
			<div class="timeline__head">
				{Logo && <Logo class="timeline__logo" aria-hidden="true" />}
				<h3 class="timeline__company">{company}</h3>
			</div>
			<p class="timeline__role">{role}</p>
			<p class="timeline__dates">{dates}</p>
		</li>
	))}
</ol>

<style>
	.timeline {
		/* Rail position and the text's indent from it, shared by the track,
		   the fill and the stop markers. */
		--rail-x: 0.5rem;
		--indent: 2.75rem;
		/* Height of each stop's heading row, so the marker can sit on its
		   centre line. */
		--head: 2.5rem;
		--progress: 1;
		position: relative;
		display: grid;
		gap: 2.75rem;
		margin: 0;
		padding: 0.25rem 0 0.25rem var(--indent);
		list-style: none;
	}
	@media (min-width: 48rem) {
		.timeline { --indent: 3.5rem; }
	}
	/* ::before is the track, ::after the fill, scaled down from the top to
	   --progress. */
	.timeline::before,
	.timeline::after {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		left: var(--rail-x);
		width: 2px;
		margin-left: -1px;
		border-radius: 1px;
	}
	.timeline::before { background: var(--line); }
	.timeline::after {
		background: var(--accent);
		transform-origin: top;
		transform: scaleY(var(--progress));
	}

	.timeline__stop {
		position: relative;
		display: grid;
		gap: 0.35rem;
	}
	/* Stop marker, centred on the rail beside the company name. */
	.timeline__stop::before {
		content: '';
		position: absolute;
		top: calc(var(--head) / 2);
		left: calc(var(--rail-x) - var(--indent));
		width: 0.875rem;
		height: 0.875rem;
		margin: -0.4375rem 0 0 -0.4375rem;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 0 4px var(--ground);
		transition: background-color 0.3s ease;
	}
	.timeline.is-live .timeline__stop:not(.is-lit)::before { background: var(--line); }

	.timeline__head {
		display: flex;
		align-items: center;
		gap: 0.875rem;
		min-height: var(--head);
	}
	/* :global because the class lands on an imported SVG component. Every
	   logo fits the same square, whatever its aspect ratio, so a wide mark
	   doesn't dwarf a compact one. */
	.timeline__head :global(.timeline__logo) {
		width: 2rem;
		height: 2rem;
		flex-shrink: 0;
		color: var(--text);
	}
	.timeline__company {
		font-size: 1.375rem;
		line-height: 1.25;
		letter-spacing: -0.01em;
	}
	.timeline__role {
		margin: 0;
		color: var(--text-soft);
	}
	.timeline__dates {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.875rem;
		color: var(--muted);
	}
</style>

<script>
	/* The fill reaches a point on the rail when that point passes 60% of the
	   way down the viewport. */
	const ANCHOR = 0.6;
	const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

	document.querySelectorAll<HTMLElement>('.timeline').forEach((root) => {
		if (!motionOk) return;

		const stops = [...root.querySelectorAll<HTMLElement>('.timeline__stop')];
		let reached = 0;
		let queued = false;

		const update = () => {
			queued = false;
			const { top, height } = root.getBoundingClientRect();
			const progress = Math.min(Math.max((window.innerHeight * ANCHOR - top) / height, 0), 1);
			if (progress <= reached) return;
			reached = progress;
			root.style.setProperty('--progress', String(reached));
			stops.forEach((stop) => {
				stop.classList.toggle('is-lit', stop.offsetTop <= reached * height);
			});
			if (reached === 1) window.removeEventListener('scroll', onScroll);
		};
		const onScroll = () => {
			if (!queued) {
				queued = true;
				requestAnimationFrame(update);
			}
		};

		root.classList.add('is-live');
		root.style.setProperty('--progress', '0');
		window.addEventListener('scroll', onScroll, { passive: true });
		update();
	});
</script>
