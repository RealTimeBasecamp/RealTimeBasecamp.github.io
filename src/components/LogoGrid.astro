---
/**
 * A flat panel of logos split by hairlines, like the Editor Menu Shelf Pro
 * homepage's PortableGrid. Each cell shows the logo (if there is one), the
 * name and an optional note. Logos are painted with currentColor.
 *
 * Props:
 *   items  LogoItem[] from src/data/logos.ts
 *   wide   two-column cells with room for a note (experience) instead of
 *          compact logo tiles (clients, software)
 */
import type { LogoItem } from '../data/logos';

interface Props {
	items: LogoItem[];
	wide?: boolean;
}
const { items, wide = false } = Astro.props;
---

<ul class:list={['logos', { 'logos--wide': wide }]}>
	{items.map(({ name, logo: Logo, wordmark, note }) => (
		<li class="logos__cell">
			{Logo && <Logo class:list={['logos__mark', { 'logos__mark--word': wordmark }]} aria-hidden="true" />}
			<span class:list={['logos__name', { 'sr-only': wordmark }]}>{name}</span>
			{note && <span class="logos__note">{note}</span>}
		</li>
	))}
</ul>

<style>
	/* Each cell draws its right and bottom hairline; the panel clips the ones
	   on its outer edge. Unlike gaps over a line-coloured background, an
	   unfilled slot in the last row stays the panel colour. */
	.logos {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		margin: 0;
		padding: 0;
		list-style: none;
		background: var(--ground-lift);
		border: 1px solid var(--line);
		border-radius: 12px;
		overflow: hidden;
	}
	.logos--wide { grid-template-columns: 1fr; }
	@media (min-width: 40rem) {
		.logos { grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr)); }
		.logos--wide { grid-template-columns: repeat(2, 1fr); }
	}
	@media (min-width: 62rem) {
		.logos--wide { grid-template-columns: repeat(4, 1fr); }
	}

	.logos__cell {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		min-height: 7rem;
		padding: 1.25rem 1rem;
		box-shadow: 1px 0 0 var(--line), 0 1px 0 var(--line);
		text-align: center;
		color: var(--text-soft);
	}
	.logos--wide .logos__cell {
		align-items: flex-start;
		justify-content: flex-start;
		text-align: left;
		padding: 1.5rem;
	}

	/* :global because the class lands on an imported SVG component. */
	.logos__cell :global(.logos__mark) {
		height: 1.75rem;
		width: auto;
	}
	/* A logo that spells the name stands alone, a little larger. */
	.logos__cell :global(.logos__mark--word) {
		height: 2.25rem;
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
	.logos__name {
		font-weight: 600;
		line-height: 1.3;
		color: var(--text);
	}
	.logos__note {
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--muted);
	}
</style>
