---
/**
 * Logos floating on the page, no panel around them. Logos are painted with
 * currentColor.
 *
 * Props:
 *   items  LogoItem[] from src/data/logos.ts
 *   names  show each name under its logo (software). When false (clients),
 *          a logo stands alone and its name is kept for screen readers only.
 *          An item without a logo always shows its name.
 */
import type { LogoItem } from '../data/logos';

interface Props {
	items: LogoItem[];
	names?: boolean;
}
const { items, names = true } = Astro.props;
---

<ul class="logos">
	{items.map(({ name, logo: Logo }) => (
		<li class="logos__cell">
			{Logo && <Logo class="logos__mark" aria-hidden="true" />}
			<span class:list={['logos__name', { 'sr-only': Logo && !names }]}>{name}</span>
		</li>
	))}
</ul>

<style>
	.logos {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(7.5rem, 1fr));
		gap: 2.5rem 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	@media (min-width: 40rem) {
		.logos { grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr)); }
	}

	.logos__cell {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.875rem;
		min-height: 4rem;
		text-align: center;
		color: var(--text-soft);
	}

	/* :global because the class lands on an imported SVG component. */
	.logos__cell :global(.logos__mark) {
		height: 3.25rem;
		max-width: 100%;
		width: auto;
	}
	@media (min-width: 40rem) {
		.logos__cell :global(.logos__mark) { height: 4rem; }
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
	.logos__name {
		font-size: 1.125rem;
		font-weight: 600;
		line-height: 1.3;
		color: var(--text);
	}
</style>
