---
/**
 * Homepage intro: photo, name and title line. The .reveal-N classes stagger
 * the entrance (keyframes in src/styles/base.css).
 */
import { Image } from 'astro:assets';
import robFraser from '../assets/rob-fraser.png';
---

<section class="hero gutter">
	<Image
		class="hero__photo reveal reveal-1"
		src={robFraser}
		alt="Rob Fraser"
		width={144}
		height={144}
		densities={[1, 2]}
		loading="eager"
	/>
	<div class="reveal reveal-2">
		<h1 class="hero__name">Rob Fraser</h1>
		<p class="hero__role">UE5 Technical Artist | Pipeline | Mentor @ MentorCruise</p>
	</div>
</section>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.5rem;
		padding-top: 3.5rem;
		padding-bottom: 3rem;
	}
	@media (min-width: 36rem) {
		.hero {
			flex-direction: row;
			align-items: center;
			gap: 2rem;
		}
	}
	@media (min-width: 992px) { .hero { padding-top: 5.5rem; } }

	.hero__photo {
		width: 7rem;
		height: 7rem;
		flex-shrink: 0;
		border-radius: 50%;
		object-fit: cover;
		border: 3px solid var(--accent);
	}
	@media (min-width: 36rem) {
		.hero__photo {
			width: 9rem;
			height: 9rem;
		}
	}

	.hero__name {
		font-size: clamp(2.5rem, 6vw, 4rem);
		line-height: 1.06;
		letter-spacing: -0.025em;
		margin: 0 0 0.75rem;
	}
	.hero__role {
		margin: 0;
		color: var(--text-soft);
		font-size: 1.0625rem;
		line-height: 1.6;
	}
</style>
