---
/**
 * Sticky site header, adapted from the Editor Menu Shelf Pro masthead
 * (src/components/home/Masthead.astro). Flat at the top of the page; once the
 * page scrolls it turns translucent and blurs what passes underneath.
 *
 * Below 50rem it uses the same geometry as the plugin docs header (3.5rem
 * tall, 1rem padding), so the logo doesn't move between the two sites.
 *
 * Right side: the site navigation (SiteNav on desktop, PageMenu below
 * 50rem), then Contact me, the site's one filled button. Profile icons
 * live in the footer.
 */
import Lockup from './Lockup.astro';
import SiteNav from './SiteNav.astro';
import PageMenu from './PageMenu.astro';
import { CONTACT_LINK } from '../data/nav';
---

<div class="masthead-sentinel" aria-hidden="true"></div>
<header class="masthead gutter">
	<a class="masthead__brand" href="/" aria-label="Real Time Basecamp home">
		<Lockup />
	</a>
	<SiteNav />
	<PageMenu />
	{CONTACT_LINK && (
		<>
			<span class="masthead__divider" aria-hidden="true"></span>
			<a class="btn btn--primary masthead__contact" href={CONTACT_LINK.href}>{CONTACT_LINK.label}</a>
		</>
	)}
</header>

<style>
	.masthead {
		position: sticky;
		top: 0;
		z-index: 50;
		display: flex;
		align-items: center;
		gap: 1rem;
		padding-top: 0.9375rem;
		padding-bottom: 0.9375rem;
		background: var(--ground);
		/* Transparent rather than absent, so it fades in with the glass
		   instead of adding 1px on first scroll. */
		border-bottom: 1px solid transparent;
		transition: background-color 0.3s ease, border-color 0.3s ease,
		            backdrop-filter 0.3s ease;
	}
	/* --ground at 54%: the alpha is what lets the blur read. */
	.masthead--stuck {
		background: rgba(28, 29, 33, 0.54);
		backdrop-filter: blur(14px) saturate(160%);
		-webkit-backdrop-filter: blur(14px) saturate(160%);
		border-bottom-color: rgba(255, 255, 255, 0.07);
	}
	@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
		.masthead--stuck { background: var(--ground); }
	}
	/* Watched instead of the header, which is sticky and never leaves the
	   viewport. The 1px of height is absorbed by the negative margin. */
	.masthead-sentinel {
		height: 1px;
		margin-bottom: -1px;
		pointer-events: none;
	}
	.masthead__brand {
		display: flex;
		align-items: center;
		text-decoration: none;
		margin-right: auto;
	}
	.masthead__divider {
		width: 1px;
		height: 1.25rem;
		background: var(--line);
	}
	@media (max-width: 50rem) {
		.masthead {
			height: 3.5rem;
			padding: 0 1rem;
			gap: 0.5rem;
		}
		.masthead__divider { display: none; }
	}
	/* Too narrow for the page menu and the button together; PageMenu lists
	   Contact me instead. */
	@media (max-width: 25rem) {
		.masthead__contact { display: none; }
	}
</style>

<script>
	/* Glass on once the 1px sentinel at the top of the page scrolls away. */
	const header = document.querySelector('.masthead');
	const sentinel = document.querySelector('.masthead-sentinel');

	if (header && sentinel && 'IntersectionObserver' in window) {
		new IntersectionObserver((entries) => {
			header.classList.toggle('masthead--stuck', !entries[0].isIntersecting);
		}, { threshold: 0 }).observe(sentinel);
	}
</script>
