---
/**
 * Full-width row of circular stats. Each ring fills and its number counts up
 * once, slowly, when the row scrolls into view. The HTML holds the final
 * values, so without JS or with reduced motion the stats are simply there.
 *
 * Entries live in src/data/stats.ts.
 */
import { STATS } from '../data/stats';
---

<ul class="rings">
	{STATS.map(({ value, suffix = '', label, icon: Icon }) => (
		<li class="ring">
			<div class="ring__dial">
				<svg class="ring__svg" viewBox="0 0 120 120" aria-hidden="true">
					<circle class="ring__track" cx="60" cy="60" r="54" />
					<circle class="ring__fill" cx="60" cy="60" r="54" pathLength="100" />
				</svg>
				<span class="ring__inner">
					{Icon && <Icon class="ring__icon" aria-hidden="true" />}
					<span class="ring__value">
						<span class="ring__num" data-to={value}>{value}</span>{suffix}
					</span>
				</span>
			</div>
			<p class="ring__label">{label}</p>
		</li>
	))}
</ul>

<style>
	/* Three across at every width; the dials shrink on phones rather than
	   stacking into a screen-high column. */
	.rings {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	@media (min-width: 40rem) {
		.rings { gap: 2rem; }
	}

	.ring {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		text-align: center;
	}
	.ring__dial {
		position: relative;
		width: min(11rem, 100%);
		aspect-ratio: 1;
		/* Inner text scales with the dial. */
		container-type: inline-size;
	}
	.ring__svg {
		display: block;
		width: 100%;
		height: 100%;
		/* Start the stroke at 12 o'clock. */
		transform: rotate(-90deg);
	}
	.ring__track,
	.ring__fill {
		fill: none;
		stroke-width: 4;
	}
	.ring__track { stroke: var(--line); }
	.ring__fill {
		stroke: var(--accent);
		stroke-linecap: round;
		stroke-dasharray: 100;
		stroke-dashoffset: 0;
		transition: stroke-dashoffset 2.4s var(--ease);
	}
	/* Set by the script before the ring is seen; removed to play the fill. */
	.rings.is-pending .ring__fill { stroke-dashoffset: 100; }

	.ring__inner {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
	}
	/* :global because the class lands on an imported SVG component. */
	.ring__inner :global(.ring__icon) {
		height: 14cqi;
		width: auto;
		color: var(--text-soft);
	}
	.ring__value {
		font-size: 25cqi;
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.02em;
		font-variant-numeric: tabular-nums;
	}
	.ring__label {
		margin: 0;
		max-width: 20ch;
		font-size: 0.8125rem;
		line-height: 1.4;
		color: var(--text-soft);
	}
	@media (min-width: 40rem) {
		.ring__label { font-size: 1rem; }
	}
</style>

<script>
	/* Count up and fill once the row is a third visible. Skipped entirely for
	   reduced motion or old browsers, which keep the final values. */
	const DURATION = 2400;
	const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

	document.querySelectorAll<HTMLElement>('.rings').forEach((root) => {
		if (!motionOk || !('IntersectionObserver' in window)) return;

		const nums = [...root.querySelectorAll<HTMLElement>('.ring__num')];
		root.classList.add('is-pending');
		nums.forEach((n) => { n.textContent = '0'; });

		const observer = new IntersectionObserver((entries) => {
			if (!entries[0].isIntersecting) return;
			observer.disconnect();
			root.classList.remove('is-pending');

			const start = performance.now();
			const tick = (now: number) => {
				const t = Math.min((now - start) / DURATION, 1);
				const eased = 1 - Math.pow(1 - t, 3);
				nums.forEach((n) => {
					n.textContent = String(Math.round(Number(n.dataset.to) * eased));
				});
				if (t < 1) requestAnimationFrame(tick);
			};
			requestAnimationFrame(tick);
		}, { threshold: 0.35 });

		observer.observe(root);
	});
</script>
