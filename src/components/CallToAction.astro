---
/**
 * A centred call to action: a large line, one short sentence and a big
 * white button (the same white as the masthead's Contact me, the site's
 * main action). Sits under a section's content, after the proof.
 *
 * Props:
 *   title  the large line
 *   text   the sentence under it
 *   label  button text; the arrow is added here
 *   href      button target
 *   external  open the target in a new tab
 */
interface Props {
	title: string;
	text: string;
	label: string;
	href: string;
	external?: boolean;
}
const { title, text, label, href, external = false } = Astro.props;
const newTab = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<div class="cta">
	<p class="cta__title">{title}</p>
	<p class="cta__text">{text}</p>
	<a class="btn cta__btn" href={href} {...newTab}>{label} &#8594;</a>
</div>

<style>
	.cta {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		margin: 0;
		text-align: center;
	}
	/* Under other content in the same section (e.g. the Clients logos), one
	   block gap; alone in a section, the section's own gap is enough. */
	:global(*) + .cta {
		margin-top: var(--block-gap);
	}
	.cta__title {
		max-width: 28ch;
		margin: 0;
		font-size: clamp(1.5rem, 3vw, 2rem);
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: -0.02em;
		color: var(--text);
	}
	.cta__text {
		margin: 0;
		color: var(--text-soft);
	}
	/* Bigger than the standard .btn: this is the page's main ask. */
	.cta__btn {
		margin-top: 0.75rem;
		padding: 0.75rem 1.5rem;
		font-size: 1rem;
		background: var(--text);
		color: var(--ground);
	}
	.cta__btn:hover {
		background: var(--text-soft);
	}
</style>
