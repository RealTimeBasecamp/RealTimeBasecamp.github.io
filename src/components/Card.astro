---
/**
 * One BentoGrid tile, from a HomeCard entry (src/data/homeCards.ts).
 *
 * Sizes, once the grid has room for them:
 *   large  two columns wide, two rows tall (from 62rem; full row on tablet)
 *   small  one cell
 *   wide   the whole row, laid out in a single line from tablet up
 *
 * The media (screenshot or rating badge) sits last and is pushed to the
 * bottom, so tiles in the same row line up whatever their text length.
 */
import { Image } from 'astro:assets';
import type { HomeCard } from '../data/homeCards';

type Props = HomeCard;
const { size, eyebrow, title, text, tag, icon: CardIcon, image, badge, links } = Astro.props;
---

<article class:list={['card', `card--${size}`]}>
	<p class="card__eyebrow">
		{CardIcon && <CardIcon class="card__icon" aria-hidden="true" />}
		{eyebrow}
	</p>
	<div class="card__title-row">
		<h2 class="card__title">{title}</h2>
		{tag && <span class="card__tag">{tag}</span>}
	</div>
	{text && <p class="card__text">{text}</p>}
	<div class="card__actions">
		{links.map((link) => (
			<a
				class:list={['btn', link.primary ? 'btn--primary' : 'btn--ghost']}
				href={link.href}
				target={link.external ? '_blank' : undefined}
				rel={link.external ? 'noopener noreferrer' : undefined}
			>{link.label} &#8594;</a>
		))}
	</div>
	{image && (
		<Image
			class="card__image"
			src={image.src}
			alt={image.alt}
			widths={[640, 960, 1280]}
			sizes="(min-width: 62rem) 60vw, 100vw"
			format="png"
		/>
	)}
	{badge && (
		<div class="card__badge">
			<img src={badge.src} alt={badge.alt} width="840" height="450" loading="lazy" />
		</div>
	)}
</article>

<style>
	.card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.75rem;
		min-width: 0;
		padding: 1.5rem;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: var(--ground-lift);
	}
	@media (min-width: 48rem) {
		.card--large,
		.card--wide { grid-column: 1 / -1; }
	}
	@media (min-width: 62rem) {
		.card--large {
			grid-column: span 2;
			grid-row: span 2;
			background:
				radial-gradient(ellipse at 50% 0%, rgba(179, 199, 255, 0.08) 0%, transparent 65%),
				var(--ground-lift);
		}
	}

	.card__eyebrow {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.13em;
		text-transform: uppercase;
		color: var(--muted);
	}
	/* :global because the class lands on the SVG component's root, which
	   carries no scope attribute. Height only, so wide marks keep their ratio. */
	.card :global(.card__icon) {
		height: 1.25rem;
		width: auto;
		color: var(--text-soft);
	}

	.card__title-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.85rem;
	}
	.card__title {
		font-size: 1.375rem;
		line-height: 1.2;
		letter-spacing: -0.015em;
	}
	.card--large .card__title {
		font-size: clamp(1.625rem, 3vw, 2.125rem);
		letter-spacing: -0.02em;
	}
	.card__tag {
		padding: 0.15rem 0.6rem;
		border: 1px solid var(--accent-deep);
		border-radius: 999px;
		background: var(--accent-low);
		color: var(--accent);
		font-size: 0.75rem;
		font-weight: 600;
		white-space: nowrap;
	}
	.card__text {
		margin: 0;
		max-width: 58ch;
		color: var(--text-soft);
	}

	.card__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	/* A ghost button has no fill, so its padding reads as an indent. Pull a
	   leading one back so its label lines up with the text above. */
	.card__actions .btn--ghost:first-child {
		margin-left: -0.85rem;
	}
	/* Bottom-aligned: the media when there is one, else the buttons. */
	.card__actions:last-child,
	.card__badge {
		margin-top: auto;
	}

	.card__image {
		display: block;
		width: 100%;
		height: auto;
		margin-top: auto;
		border: var(--shot-border);
		border-radius: var(--shot-radius);
	}

	/* MentorCruise's badge has their dark-green wordmark above the score
	   pill, which disappears on this ground. The frame's ratio shows only the
	   bottom 330 of the image's 450px, and object-position keeps the pill. */
	.card__badge {
		width: 100%;
		max-width: 16rem;
		aspect-ratio: 840 / 330;
		overflow: hidden;
	}
	.card__badge img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 100%;
	}

	@media (min-width: 48rem) {
		.card--wide {
			flex-direction: row;
			flex-wrap: wrap;
			align-items: center;
			gap: 1rem 1.5rem;
		}
		.card--wide .card__actions {
			margin-left: auto;
			margin-top: 0;
		}
	}
</style>
