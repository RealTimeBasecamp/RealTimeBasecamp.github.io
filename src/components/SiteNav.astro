---
/**
 * Desktop navigation in the masthead: each master page from src/data/nav.ts,
 * in order. A section with `links` opens a hover panel: a card under its
 * trigger, centred on it, listing each link with a short line under it.
 * Hidden below 50rem, where PageMenu.astro takes over.
 *
 * Panels open on hover and on keyboard focus (CSS only). They close after a
 * short delay so the pointer can cross from the trigger into the card. The
 * script only nudges a card sideways when it would run off the window.
 */
import { NAV_SECTIONS, pageNameFor, type NavLink } from '../data/nav';

const path = Astro.url.pathname;
const currentName = pageNameFor(path);

/** Link attributes: current page marker, new tab for external links. */
const attrs = ({ href, external }: NavLink) => ({
	href,
	'aria-current': href === path ? ('page' as const) : undefined,
	...(external && { target: '_blank', rel: 'noopener noreferrer' }),
});
---

{NAV_SECTIONS.length > 1 && (
	<nav class="site-nav" aria-label="Site">
		<ul class="site-nav__list">
			{NAV_SECTIONS.map((section) => {
				/* Without a live page of its own, the trigger is a button that
				   only opens the panel (on hover or focus). */
				const Trigger = section.linked ? 'a' : 'button';
				return (
					<li class="site-nav__item">
						<Trigger
							class:list={['site-nav__trigger', { 'is-current': section.label === currentName }]}
							{...(section.linked ? attrs(section) : { type: 'button' })}
						>
							{section.label}
						</Trigger>
						{section.links && section.links.length > 0 && (
							<div class="site-nav__panel">
								<div class="site-nav__card">
									<ul class="site-nav__links">
										{section.links.map((link) => (
											<li>
												<a class="site-nav__link" {...attrs(link)}>
													<span class="site-nav__label">
														{link.label}
														{link.external && <span aria-hidden="true"> &#8599;</span>}
													</span>
													{link.description && <span class="site-nav__desc">{link.description}</span>}
												</a>
											</li>
										))}
									</ul>
									{section.more && (
										<a class="site-nav__more" {...attrs(section.more)}>{section.more.label} &#8594;</a>
									)}
								</div>
							</div>
						)}
					</li>
				);
			})}
		</ul>
	</nav>
)}

<style>
	.site-nav__list {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.site-nav__trigger {
		display: inline-flex;
		align-items: center;
		height: 2.2rem;
		padding: 0 0.75rem;
		border: none;
		border-radius: 6px;
		background: transparent;
		color: var(--text-soft);
		font: inherit;
		font-size: 0.875rem;
		font-weight: 500;
		text-decoration: none;
		cursor: pointer;
		transition: background-color 0.2s ease, color 0.2s ease;
	}
	.site-nav__trigger.is-current { color: var(--text); }
	.site-nav__item { position: relative; }
	.site-nav__item:hover .site-nav__trigger,
	.site-nav__item:focus-within .site-nav__trigger {
		background: rgba(255, 255, 255, 0.08);
		color: var(--text);
	}

	/* Hidden by delaying visibility, not removing it, so the card stays up
	   for a moment after the pointer leaves the trigger. The padding is an
	   invisible bridge from the trigger down past the masthead's edge.
	   --nudge is set by the script when the card would overflow. */
	.site-nav__panel {
		position: absolute;
		top: 100%;
		left: 50%;
		width: max-content;
		padding-top: 1.4rem;
		transform: translateX(calc(-50% + var(--nudge, 0px)));
		visibility: hidden;
		opacity: 0;
		transition: opacity 0.15s ease, visibility 0s linear 0.15s;
	}
	.site-nav__item:hover .site-nav__panel,
	.site-nav__item:focus-within .site-nav__panel {
		visibility: visible;
		opacity: 1;
		transition-delay: 0s;
	}
	/* Two layers, like Linear's: an outer frame and a darker inner section
	   holding the items. */
	.site-nav__card {
		padding: 0.375rem;
		background: var(--ground-lift);
		border: 1px solid var(--line);
		border-radius: 12px;
		box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
	}
	/* Every item is the same size in every panel, like Linear's: fixed width,
	   one-line label, room for a two-line description. Items sit side by
	   side, so the card is as wide as its items; hairlines split them so
	   the row is easy to scan. */
	.site-nav__links {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: 16rem;
		margin: 0;
		padding: 0.5rem 0;
		list-style: none;
		background: var(--ground);
		border: 1px solid var(--line);
		border-radius: 8px;
	}
	.site-nav__links > li {
		display: flex;
		padding: 0 0.5rem;
	}
	.site-nav__links > li + li { border-left: 1px solid var(--line); }
	.site-nav__link {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		/* Fixed, with room for a two-line description (clamped below), so a
		   short description doesn't make a shorter card. */
		height: 6rem;
		padding: 0.9rem 1rem;
		border-radius: 8px;
		text-decoration: none;
		transition: background-color 0.2s ease;
	}
	.site-nav__link:hover { background: rgba(255, 255, 255, 0.05); }
	.site-nav__label {
		overflow: hidden;
		color: var(--text);
		font-size: 0.875rem;
		font-weight: 600;
		white-space: nowrap;
		text-overflow: ellipsis;
	}
	.site-nav__link[aria-current='page'] .site-nav__label { color: var(--accent); }
	.site-nav__desc {
		display: -webkit-box;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		color: var(--muted);
		font-size: 0.8125rem;
		line-height: 1.45;
	}
	.site-nav__more {
		display: block;
		padding: 0.75rem 1rem 0.5rem;
		color: var(--accent);
		font-size: 0.875rem;
		font-weight: 500;
		text-decoration: none;
	}
	.site-nav__more:hover { opacity: 0.75; }

	.site-nav__trigger:focus-visible,
	.site-nav__link:focus-visible,
	.site-nav__more:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	/* No fade, but keep the close delay: it's what lets the pointer cross. */
	@media (prefers-reduced-motion: reduce) {
		.site-nav__panel { transition: visibility 0s linear 0.15s; }
	}
	@media (max-width: 50rem) {
		.site-nav { display: none; }
	}
</style>

<script>
	/* Cards centre under their trigger. This only shifts one if it would run
	   off either side of the window. Measured on open, since the window may
	   have resized. */
	const EDGE = 16;

	document.querySelectorAll<HTMLElement>('.site-nav__item').forEach((item) => {
		const panel = item.querySelector<HTMLElement>('.site-nav__panel');
		if (!panel) return;
		const fit = () => {
			panel.style.setProperty('--nudge', '0px');
			const { left, right } = panel.getBoundingClientRect();
			const pastRight = right - (document.documentElement.clientWidth - EDGE);
			const shift = pastRight > 0 ? -pastRight : Math.max(0, EDGE - left);
			panel.style.setProperty('--nudge', `${shift}px`);
		};
		item.addEventListener('pointerenter', fit);
		item.addEventListener('focusin', fit);
	});
</script>
