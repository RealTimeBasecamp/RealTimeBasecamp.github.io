---
/**
 * Row of three infographics, each drawn its own way (see `kind` in
 * src/data/stats.ts): a logo that fills with colour, a staircase of bars, a
 * grid of dots.
 * Each one plays once, when it is well inside the viewport, and its number
 * counts up alongside. The HTML holds the final state, so without JS or with
 * reduced motion the stats are simply there.
 */
import { STATS } from '../data/stats';

/** Columns for the dot grid: as square as the count allows (30 -> 6 x 5). */
const dotColumns = (n: number) => Math.ceil(Math.sqrt(n));
---

<ul class="stats">
	{STATS.map(({ value, suffix = '', label, kind, icon: Icon }) => {
		const units = Array.from({ length: value }, (_, i) => i);
		return (
			<li class:list={['stat', `stat--${kind}`]} style={`--n: ${value}`}>
				<div class="stat__art">
					{kind === 'fill' && Icon && (
						<span class="fill" aria-hidden="true">
							<Icon class="fill__base" />
							<Icon class="fill__top" />
						</span>
					)}
					{kind === 'bars' && (
						<span class="bars" aria-hidden="true">
							{units.map((i) => <span class="bars__bar" style={`--i: ${i}`} />)}
						</span>
					)}
					{kind === 'dots' && (
						<span class="dots" style={`--cols: ${dotColumns(value)}`} aria-hidden="true">
							{units.map((i) => <span class="dots__dot" style={`--i: ${i}`} />)}
						</span>
					)}
				</div>
				<span class="stat__value">
					{Icon && kind !== 'fill' && <Icon class="stat__icon" aria-hidden="true" />}
					<span><span class="stat__num" data-to={value}>{value}</span>{suffix}</span>
				</span>
				<p class="stat__label">{label}</p>
			</li>
		);
	})}
</ul>

<style>
	/* Three across at every width; the art shrinks on phones rather than
	   stacking into a screen-high column. Extra room above and below: the
	   row has no heading and follows a dense logo grid (Software), so it
	   needs air to read as its own section. */
	.stats {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.75rem;
		margin: 2.5rem 0;
		padding: 0;
		list-style: none;
	}
	@media (min-width: 40rem) {
		.stats { gap: 2rem; }
	}

	.stat {
		/* Every animation in a stat spreads its units over this time. */
		--play: 2.2s;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		text-align: center;
		/* The number scales with the column. */
		container-type: inline-size;
	}
	.stat__art {
		position: relative;
		width: min(11rem, 100%);
		aspect-ratio: 1;
	}

	.stat__value {
		display: inline-flex;
		align-items: center;
		gap: 0.3em;
		font-size: clamp(1.5rem, 20cqi, 3rem);
		font-weight: 600;
		line-height: 1;
		letter-spacing: -0.02em;
		font-variant-numeric: tabular-nums;
	}
	/* :global because the class lands on an imported SVG component. */
	.stat__value :global(.stat__icon) {
		height: 0.7em;
		width: auto;
		color: var(--text-soft);
	}
	.stat__label {
		margin: 0;
		max-width: 20ch;
		font-size: 0.8125rem;
		line-height: 1.4;
		color: var(--text-soft);
	}
	@media (min-width: 40rem) {
		.stat__label { font-size: 1rem; }
	}

	/* --- fill: the logo colours in from bottom to top. Two copies stacked:
	   a dim base and a white top layer revealed by its clip-path. White, not
	   the accent: Epic's brand guidelines don't allow recolouring the logo. --- */
	.fill {
		position: relative;
		display: block;
		width: 100%;
		height: 100%;
		padding: 6%;
		box-sizing: border-box;
	}
	.fill :global(.fill__base),
	.fill :global(.fill__top) {
		position: absolute;
		inset: 6%;
		width: 88%;
		height: 88%;
	}
	.fill :global(.fill__base) { color: var(--line); }
	.fill :global(.fill__top) {
		color: var(--text);
		clip-path: inset(0 0 0 0);
		transition: clip-path var(--play) var(--ease);
	}
	.stat.is-pending .fill :global(.fill__top) { clip-path: inset(100% 0 0 0); }

	/* --- bars: one per year, each a step taller, rising left to right --- */
	.bars {
		display: flex;
		align-items: flex-end;
		gap: 6%;
		height: 100%;
		padding: 8% 4% 0;
		box-sizing: border-box;
		border-bottom: 2px solid var(--line);
	}
	.bars__bar {
		flex: 1;
		height: calc((var(--i) + 1) / var(--n) * 100%);
		border-radius: 3px 3px 0 0;
		background: var(--accent);
		transform-origin: bottom;
		transition: transform 0.5s var(--ease);
		transition-delay: calc(var(--i) * var(--play) / var(--n));
	}
	.stat.is-pending .bars__bar { transform: scaleY(0); }

	/* --- dots: one per person, lighting up in turn --- */
	.dots {
		display: grid;
		grid-template-columns: repeat(var(--cols), 1fr);
		align-content: center;
		gap: 10%;
		height: 100%;
		padding: 6%;
		box-sizing: border-box;
	}
	.dots__dot {
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--accent);
		transition: background-color 0.3s ease, transform 0.3s var(--ease);
		transition-delay: calc(var(--i) * var(--play) / var(--n));
	}
	.stat.is-pending .dots__dot {
		background: var(--line);
		transform: scale(0.6);
	}
</style>

<script>
	/* Each stat plays once it is three quarters visible and clear of the
	   bottom edge, so it is never over before the visitor gets there. Skipped
	   for reduced motion or old browsers, which keep the final values. */
	const DURATION = 2200;
	const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

	const countUp = (num: HTMLElement) => {
		const to = Number(num.dataset.to);
		const start = performance.now();
		const tick = (now: number) => {
			const t = Math.min((now - start) / DURATION, 1);
			num.textContent = String(Math.round(to * (1 - Math.pow(1 - t, 3))));
			if (t < 1) requestAnimationFrame(tick);
		};
		requestAnimationFrame(tick);
	};

	if (motionOk && 'IntersectionObserver' in window) {
		const observer = new IntersectionObserver((entries) => {
			entries.forEach(({ isIntersecting, target }) => {
				if (!isIntersecting) return;
				observer.unobserve(target);
				target.classList.remove('is-pending');
				const num = target.querySelector<HTMLElement>('.stat__num');
				if (num) countUp(num);
			});
		}, { threshold: 0.75, rootMargin: '0px 0px -15% 0px' });

		document.querySelectorAll<HTMLElement>('.stat').forEach((stat) => {
			stat.classList.add('is-pending');
			const num = stat.querySelector<HTMLElement>('.stat__num');
			if (num) num.textContent = '0';
			observer.observe(stat);
		});
	}
</script>
