---
/**
 * Grid for Card tiles of mixed sizes: one column on phones, two from
 * tablet, three from desktop. Each Card sets its own span from its `size`.
 */
---

<div class="bento gutter reveal reveal-3">
	<slot />
</div>

<style>
	.bento {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
	}
	@media (min-width: 48rem) {
		.bento { grid-template-columns: repeat(2, 1fr); }
	}
	@media (min-width: 62rem) {
		.bento { grid-template-columns: repeat(3, 1fr); }
	}
</style>
