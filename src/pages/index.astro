---
/**
 * Homepage, which is also the bio. This file is only the running order of
 * the page: the shell is src/layouts/BaseLayout.astro, the words and logos
 * are in src/data/.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Stats from '../components/Stats.astro';
import Timeline from '../components/Timeline.astro';
import LogoGrid from '../components/LogoGrid.astro';
import TestimonialCarousel from '../components/TestimonialCarousel.astro';
import ProductList from '../components/ProductList.astro';
import { CLIENTS, SOFTWARE } from '../data/logos';
import { EDUCATION, EXPERIENCE } from '../data/experience';
---

<BaseLayout
	title="Rob Fraser | Real Time Basecamp"
	description="Rob Fraser, UE5 Technical Artist, pipeline developer and mentor. Creator of Editor Menu Shelf Pro for Unreal Engine 5."
>
	<Hero />

	<Section>
		<Stats />
	</Section>

	<Section title="Experience" id="experience">
		<Timeline items={EXPERIENCE} />
	</Section>

	<Section title="Education" id="education">
		<Timeline items={EDUCATION} />
	</Section>

	<Section title="Clients" id="clients">
		<LogoGrid items={CLIENTS} names={false} />
	</Section>

	<Section title="Software" id="software">
		<LogoGrid items={SOFTWARE} />
	</Section>

	<Section id="mentoring">
		<TestimonialCarousel />
	</Section>

	<Section title="Products" id="products">
		<ProductList />
	</Section>

	<Section title="Blog" id="blog">
		<Fragment slot="intro">Posts are on the way. Join the newsletter below to get them first.</Fragment>
	</Section>
</BaseLayout>
