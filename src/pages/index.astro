---
/**
 * Homepage, which is also the bio. This file is only the running order of
 * the page: the shell is src/layouts/BaseLayout.astro, the words and logos
 * are in src/data/.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Stats from '../components/Stats.astro';
import Timeline from '../components/Timeline.astro';
import LogoGrid from '../components/LogoGrid.astro';
import TestimonialCarousel from '../components/TestimonialCarousel.astro';
import ProductList from '../components/ProductList.astro';
import CallToAction from '../components/CallToAction.astro';
import { CLIENTS, SOFTWARE } from '../data/logos';
import { EXPERIENCE } from '../data/experience';
import { CONTACT_LINK } from '../data/nav';
import { HIRE_CTA } from '../data/cta';
---

<BaseLayout
	title="Rob Fraser | Real Time Basecamp"
	description="Rob Fraser is a UE5 Technical Artist, Pipeline Developer and mentor with 14 years of experience in Unreal Engine."
>
	<Hero />

	<Section title="Experience" id="experience">
		<Timeline items={EXPERIENCE} />
	</Section>

	<Section title="Clients" id="clients">
		<LogoGrid items={CLIENTS} names={false} />
		{CONTACT_LINK && <CallToAction {...HIRE_CTA} href={CONTACT_LINK.href} />}
	</Section>

	<Section title="Software" id="software">
		<LogoGrid items={SOFTWARE} />
	</Section>

	<Section>
		<Stats />
	</Section>

	<Section id="mentoring">
		<TestimonialCarousel />
	</Section>

	<Section title="Products" id="products">
		<ProductList />
	</Section>
</BaseLayout>
